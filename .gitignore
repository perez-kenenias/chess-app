# ══════════════════════════════════════
# Chess Trainer — .gitignore
# ══════════════════════════════════════


# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Distribución / empaquetado
dist/
build/
*.egg-info/
*.egg

# Tests y cobertura
.pytest_cache/
.coverage
htmlcov/

# Herramientas
.mypy_cache/
.ruff_cache/


# ── Node.js / Frontend ────────────────────────────────────────
node_modules/
chess-app/dist/
chess-app/.vite/

# Logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.eslintcache


# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~


# ── Editores e IDEs ───────────────────────────────────────────
.vscode/
*.code-workspace
.idea/
*.iml
*.swp
*.swo


# ── Variables de entorno ──────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example


# ── Stockfish (binario, no va en el repo) ────────────────────
*.exe
stockfish*
!chess-backend/app/engine.py


# ── Archivos temporales ───────────────────────────────────────
*.zip
*.tar.gz
*.log
*.tmp
*.bak
