# Copia este archivo como .env en la misma carpeta chess-backend/
# y rellena tus claves antes de arrancar el servidor.

# API de Anthropic — para los comentarios de Gran Maestro con IA
# Obtén tu clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-tu_clave_aqui

# Ruta al ejecutable de Stockfish (opcional si está en el PATH del sistema)
# Windows ejemplo: C:\stockfish\stockfish-windows-x86-64-avx2.exe
# macOS/Linux: déjalo vacío si instalaste con brew o apt
# STOCKFISH_PATH=
